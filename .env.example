# انسخ الملف ده باسم .env وعدّل القيم
PORT=3000
HOST=0.0.0.0

# حساب الأدمن (بيتعمل أول تشغيل بس). لو سبت كلمة السر فاضية بتتولّد عشوائي وتتطبع في الكونسول.
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=

# سر توقيع الجلسات (24 حرف على الأقل). لو فاضي بيتولّد ويتحفظ في data/.jwt_secret
JWT_SECRET=

# لو وراء Nginx/Cloudflare: فعّلها عشان IP الحقيقي وHTTPS يتعرفوا صح
TRUST_PROXY=0

# مكان قاعدة البيانات والصور المرفوعة (اعمل منها نسخة احتياطية)
# DATA_DIR=./data

# بيانات تجريبية أول تشغيل (ضع 0 لإيقافها في الإنتاج)
SEED_DEMO=1

# الدفع الأونلاين: sandbox (تجريبي) | generic (بوابة حقيقية - شوف lib/payments.js)
PAYMENT_PROVIDER=sandbox
# PAYMENT_CHECKOUT_URL=https://your-gateway.example/checkout
# PAYMENT_WEBHOOK_SECRET=

# ---- واتساب (رسائل تلقائية للعملاء) ----
# من developers.facebook.com > تطبيقك > WhatsApp > API Setup. لو سبتهم فاضيين الرسائل بتتسجّل "يدوي" وتبعتها من لوحة الأدمن بضغطة.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE_LANG=ar
# رابط موقعك (بيتحط في رسالة تتبّع الطلب)
# PUBLIC_URL=https://yourstore.com
